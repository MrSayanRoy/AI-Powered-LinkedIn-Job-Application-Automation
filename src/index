/**
 * Fix common UTF-8 mojibake and strip a leading bullet
 * character from job titles pulled out of raw LinkedIn post text.
 */
function cleanJobTitleText(value: string | undefined): string {
  if (!value) {
    return "";
  }

  let text = value.trim();

  text = text
    .replace(/Ã¢Â€Â¢/g, "•")
    .replace(/Ã¢Â€Â“/g, "–")
    .replace(/Ã¢Â€Â”/g, "—")
    .replace(/Ã¢â‚¬Â¢/g, "•")
    .replace(/â€¢/g, "•")
    .replace(/Â·/g, "·")
    .replace(/â€“/g, "–")
    .replace(/â€”/g, "—")
    .replace(/â€™/g, "'")
    .replace(/â€œ/g, '"')
    .replace(/â€\u009d/g, '"');

  text = text.replace(/^[•·●▪◦]\s*/u, "").trim();

  return text;
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
