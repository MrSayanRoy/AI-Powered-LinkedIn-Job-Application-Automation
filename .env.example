# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Application behavior ---
# draft = create Gmail drafts, human sends them (default, recommended)
# auto  = allow automatic sending, only when all safety checks pass (see gmail/send.ts)
SEND_MODE=draft

# Minimum AI match score (0-100) required before a job is considered suitable
MATCH_THRESHOLD=70

# Only consider posts at or under this age, in hours
MAX_POST_AGE_HOURS=24

# --- Paths ---
CANDIDATE_CONFIG_PATH=./config/candidate.json
DATABASE_PATH=./data/applications.sqlite
LINKEDIN_SESSION_DIR=./browser-data/linkedin

# --- Gmail OAuth ---
# Created via `npm run gmail:auth` after placing OAuth client credentials
# (downloaded from Google Cloud Console) at ./gmail-credentials.json
GMAIL_TOKEN_PATH=./gmail-token.json
GMAIL_CREDENTIALS_PATH=./gmail-credentials.json
